{
  "name": "@jazz/lost-mode-server",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/entrypoint.mjs",
    "migrate": "node src/db/migrate.mjs",
    "create-owner": "node src/scripts/dispatch.mjs create-owner",
    "change-owner-password": "node src/scripts/dispatch.mjs change-owner-password",
    "create-device": "node src/scripts/dispatch.mjs create-device",
    "rotate-device": "node src/scripts/dispatch.mjs rotate-device",
    "pg:migrate": "node src/pg/migrate.mjs",
    "pg:import": "node src/scripts/import-sqlite-to-postgres.mjs",
    "check": "node --check src/entrypoint.mjs && node --check src/server.mjs && node --check src/pg/server.mjs && node --check src/auth/password.mjs && node --check src/pg/sessions.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
