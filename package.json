{
  "name": "@jazz/lost-mode-server",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/entrypoint.mjs",
    "migrate": "node src/pg/migrate.mjs",
    "create-owner": "node src/scripts/dispatch.mjs create-owner",
    "change-owner-password": "node src/scripts/dispatch.mjs change-owner-password",
    "list-users": "node src/scripts/dispatch.mjs list-users",
    "recover-billing-admin": "node src/scripts/dispatch.mjs recover-billing-admin",
