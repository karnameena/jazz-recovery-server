{
    "name": "@jazz/lost-mode-server",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "node --import ./src/load-env.mjs src/entrypoint.mjs",
        "create-owner": "node --import ./src/load-env.mjs src/scripts/dispatch.mjs create-owner",
        "change-owner-password": "node --import ./src/load-env.mjs src/scripts/dispatch.mjs change-owner-password",
        "create-device": "node --import ./src/load-env.mjs src/scripts/dispatch.mjs create-device",
        "rotate-device": "node --import ./src/load-env.mjs src/scripts/dispatch.mjs rotate-device",
        "pg:migrate": "node --import ./src/load-env.mjs src/pg/migrate.mjs",
        "pg:import": "node --import ./src/load-env.mjs src/scripts/import-sqlite-to-postgres.mjs",
        "test": "node --import ./src/load-env.mjs --test tests/*.test.mjs",
        "recover-billing-admin": "node --import ./src/load-env.mjs src/scripts/dispatch.mjs recover-billing-admin",
        "bootstrap-billing-admin": "node --import ./src/load-env.mjs src/scripts/pg-bootstrap-billing-admin.mjs",
        "test:cloudflare": "node cloudflare/tests/security.test.mjs && node cloudflare/tests/fcm.test.mjs && node cloudflare/tests/worker.integration.test.mjs",
        "dev": "wrangler dev --config ./cloudflare/wrangler.toml --local-protocol http"
    },
    "engines": {
        "node": ">=22.5.0"
    },
    "dependencies": {
        "@simplewebauthn/server": "^13.2.2",
        "pg": "^8.16.3"
    },
    "devDependencies": {
        "wrangler": "^4.156.0"
    }
}
