# Copy this file to .env for LOCAL development only.
# Use your existing Neon PostgreSQL database URL only if you intentionally want that database.
# Never run migration tests against production Neon.
JAZZ_DB_ENGINE=postgres
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Local website origin
LOST_MODE_PUBLIC_ORIGINS=http://localhost:5190
LOST_MODE_PUBLIC_ORIGIN=http://localhost:5190
LOST_MODE_TRUST_PROXY=false

# Local HTTP cookies / passkeys
LOST_MODE_COOKIE_SECURE=false
LOST_MODE_COOKIE_SAMESITE=Lax
JAZZ_WEBAUTHN_ORIGIN=http://localhost:5190
JAZZ_WEBAUTHN_RP_ID=localhost

# Generate long random secrets locally; keep them out of Git.
JAZZ_TRIAL_CLAIM_PEPPER=REPLACE_WITH_RANDOM_SECRET
JAZZ_DISCOUNT_CODE_PEPPER=REPLACE_WITH_RANDOM_SECRET
JAZZ_BILLING_ADMIN_BOOTSTRAP_SECRET=REPLACE_WITH_RANDOM_SECRET

# Razorpay TEST credentials only for local billing checks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Recovery photos use the local server filesystem (one current photo per device).
JAZZ_PHOTO_DIR=./var/photos

# Copy this file to .env for LOCAL development only.
# Use your existing Neon PostgreSQL database URL only if you intentionally want that database.
# Never run migration tests against production Neon.
JAZZ_DB_ENGINE=postgres
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Local website origin
LOST_MODE_PUBLIC_ORIGINS=http://localhost:5190
LOST_MODE_PUBLIC_ORIGIN=http://localhost:5190
LOST_MODE_TRUST_PROXY=false

# Local HTTP cookies / passkeys
LOST_MODE_COOKIE_SECURE=false
LOST_MODE_COOKIE_SAMESITE=Lax
JAZZ_WEBAUTHN_ORIGIN=http://localhost:5190
JAZZ_WEBAUTHN_RP_ID=localhost

# Generate long random secrets locally; keep them out of Git.
JAZZ_TRIAL_CLAIM_PEPPER=REPLACE_WITH_RANDOM_SECRET
JAZZ_DISCOUNT_CODE_PEPPER=REPLACE_WITH_RANDOM_SECRET
JAZZ_BILLING_ADMIN_BOOTSTRAP_SECRET=REPLACE_WITH_RANDOM_SECRET

# Razorpay TEST credentials only for local billing checks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Private object storage is required for recovery-photo upload flows.
# Use private, branch-scoped storage credentials; do not make the bucket public.
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
JAZZ_PHOTO_BUCKET=jazz-recovery-photos
