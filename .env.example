# Local development and hosted deployment both use PostgreSQL only.
# Set JAZZ_DB_ENGINE=postgres and provide a private Neon DATABASE_URL.
JAZZ_DB_ENGINE=postgres
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Exact HTTPS origin of the hosted Jazz Recovery WEBSITE (not the API URL).
LOST_MODE_PUBLIC_ORIGINS=https://your-jazz-recovery-website.example
LOST_MODE_COOKIE_SECURE=true
LOST_MODE_COOKIE_SAMESITE=None
LOST_MODE_TRUST_PROXY=true

# WebAuthn must match the origin where users open the website.
JAZZ_WEBAUTHN_ORIGIN=https://your-jazz-recovery-website.example
JAZZ_WEBAUTHN_RP_ID=your-jazz-recovery-website.example

# Never commit a real DATABASE_URL, username/password, bearer token, or device secret.

# Private Neon Object Storage (create a private bucket on the same Neon branch).
# Never use public_read for recovery photos. Configure these values in the API host's secret environment.
AWS_ENDPOINT_URL_S3=https://YOUR_BRANCH.storage.YOUR_NEON_ENDPOINT
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=YOUR_BRANCH_SCOPED_STORAGE_KEY
AWS_SECRET_ACCESS_KEY=YOUR_BRANCH_SCOPED_STORAGE_SECRET
JAZZ_PHOTO_BUCKET=jazz-recovery-photos
