# Render sets PORT automatically; do not hardcode the listening port.
# The backend starts with node src/server.mjs.
NODE_ENV=production

# Keep SQLite out of Git and on persistent storage (paid Render disk).
LOST_MODE_DB_PATH=/var/data/lost-mode.db

# Replace with the exact HTTPS origin of your hosted Lost Mode WEBSITE.
LOST_MODE_PUBLIC_ORIGINS=https://your-lost-mode-website.onrender.com
LOST_MODE_COOKIE_SECURE=true
LOST_MODE_COOKIE_SAMESITE=None
LOST_MODE_TRUST_PROXY=true

# Do not put usernames, passwords, bearer tokens, or device secrets in this file.
